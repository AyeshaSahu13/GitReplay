# GEMINI_API_KEY: Required for Gemini AI API calls on the Express server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH: Optional public base path for static hosting (e.g. "/gitreplay/" on GitHub Pages, or "./").
VITE_BASE_PATH="./"

# VITE_API_BASE_URL: Optional external backend URL when hosting the static frontend on GitHub Pages
# (e.g. "https://your-gitreplay-backend.run.app"). Leave empty for same-origin Express deployments.
VITE_API_BASE_URL=""
